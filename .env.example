# AI keys are not set here: each user adds their own Anthropic or Gemini key in Settings; it's stored encrypted on their account.
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts users' AI keys at rest. Changing it makes saved keys unreadable.
KEY_ENCRYPTION_SECRET=

# Optional: publishable Logo.dev token (pk_...), last step of the logo waterfall. Free at logo.dev.
LOGO_DEV_TOKEN=

# Neon Postgres + Neon Auth (created with the neon CLI; see README)
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# Optional: Cloudinary (cloudinary://API_KEY:API_SECRET@CLOUD_NAME) to mirror logos
CLOUDINARY_URL=
