# AI keys are not set here: each user adds their own Anthropic or Gemini key in the app's Settings.

# Optional: publishable Logo.dev token (pk_...), last step of the logo waterfall. Free at logo.dev.
LOGO_DEV_TOKEN=

# Neon Postgres + Neon Auth (created with the neon CLI; see README)
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# Optional: Cloudinary (cloudinary://API_KEY:API_SECRET@CLOUD_NAME) to mirror logos
CLOUDINARY_URL=
